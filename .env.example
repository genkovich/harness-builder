# Модель у форматі провайдер/модель. Типово Qwen 3.8 на Groq Free (ключ безкоштовний: console.groq.com/keys).
# Інший провайдер: зміни MODEL і заповни лише його ключ.
MODEL=groq/qwen/qwen3.8-27b
GROQ_API_KEY=
# Qwen на Groq міркує перед відповіддю. low лишає місце для відповіді в ліміті 1000 токенів.
# GROQ_REASONING=low
# MODEL=openai/gpt-4.1-mini
# OPENAI_API_KEY=
# MODEL=anthropic/claude-haiku-5-5
# ANTHROPIC_API_KEY=
# MODEL=openrouter/qwen/qwen3-32b
# OPENROUTER_API_KEY=

# Токен бота від @BotFather. Потрібен з етапу 06.
TELEGRAM_BOT_TOKEN=
# Твій chat id з відповіді бота на /start. Потрібен з етапу 09.
OWNER_CHAT_ID=
# Етап 09: вимкнути тули для всіх, через кому. Напр. DENY_TOOLS=saveNote, потім Ctrl+C і npm run web.
# DENY_TOOLS=

# Ліміти задачі (етап 04). Порожнє = типові 8 кроків і $0.05.
# MAX_TURNS=8
# MAX_COST_USD=0.05
# Ціна моделі за 1 млн токенів: input,cached,output. Потрібна, якщо твоєї моделі немає в src/model.ts.
# На Groq Free ціна 0, тож щоб побачити max_cost: PRICE=1,0.5,2 і MAX_COST_USD=0.001
# PRICE=

# Порт веб-харнесу.
PORT=3000
